datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// ENUMS
// ==============================================================================

enum Role {
  ADMIN
  DEPT
  STARTUP
  EVALUATOR
  AUDITOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum StartupStage {
  IDEATION
  EARLY_STAGE
  GROWTH
  SCALING
  MATURE
}

enum ProblemSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProblemStatus {
  DRAFT
  PUBLISHED
  IN_REVIEW
  PILOTING
  RESOLVED
  CLOSED
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum EvaluationRecommendation {
  STRONGLY_ACCEPT
  ACCEPT
  NEUTRAL
  REJECT
  STRONGLY_REJECT
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
  FINALIZED
}

enum PilotStatus {
  INITIATED
  IN_PROGRESS
  PAUSED
  COMPLETED
  FAILED
  GRADUATED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  VERIFIED
  REJECTED
  DELAYED
}

enum DisbursementStatus {
  NOT_APPLICABLE
  PENDING
  APPROVED
  DISBURSED
}

enum ProcurementType {
  DIRECT_AWARD
  INNOVATION_PARTNERSHIP
  TENDER_FAST_TRACK
  FRAMEWORK_AGREEMENT
}

enum ProcurementStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  CONTRACT_SIGNED
  FULFILLED
  TERMINATED
}

enum DocumentCategory {
  PROPOSAL_PITCH
  TECHNICAL_SPEC
  FINANCIAL_REPORT
  MILESTONE_PROOF
  PILOT_EVALUATION
  CONTRACT
  COMPLIANCE
  OTHER
}

// ==============================================================================
// MODELS (11 CORE ENTITIES)
// ==============================================================================

model Department {
  id           String           @id @default(uuid()) @db.Uuid
  name         String           @unique @db.VarChar(255)
  code         String           @unique @db.VarChar(50)
  description  String           @db.Text
  website      String?          @db.VarChar(255)
  contactEmail String           @map("contact_email") @db.VarChar(255)
  contactPhone String?          @map("contact_phone") @db.VarChar(50)
  location     String?          @db.VarChar(255)
  status       DepartmentStatus @default(ACTIVE)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  users        User[]
  problems     Problem[]
  pilots       Pilot[]
  procurements Procurement[]

  @@map("departments")
}

model Startup {
  id                 String       @id @default(uuid()) @db.Uuid
  name               String       @db.VarChar(255)
  registrationNumber String       @unique @map("registration_number") @db.VarChar(100)
  description        String       @db.Text
  industry           String       @db.VarChar(100)
  stage              StartupStage @default(EARLY_STAGE)
  website            String?      @db.VarChar(255)
  foundedYear        Int?         @map("founded_year")
  headquarters       String?      @db.VarChar(255)
  teamSize           Int?         @map("team_size")
  logoUrl            String?      @map("logo_url") @db.VarChar(500)
  verified           Boolean      @default(false)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  users        User[]
  proposals    Proposal[]
  pilots       Pilot[]
  procurements Procurement[]
  documents    Document[]

  @@map("startups")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  firstName    String     @map("first_name") @db.VarChar(100)
  lastName     String     @map("last_name") @db.VarChar(100)
  phoneNumber  String?    @map("phone_number") @db.VarChar(50)
  role         Role       @default(STARTUP)
  status       UserStatus @default(ACTIVE)
  departmentId String?    @map("department_id") @db.Uuid
  startupId    String?    @map("startup_id") @db.Uuid
  avatarUrl    String?    @map("avatar_url") @db.VarChar(500)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  department         Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  startup            Startup?     @relation(fields: [startupId], references: [id], onDelete: SetNull)
  createdProblems    Problem[]    @relation("ProblemCreator")
  submittedProposals Proposal[]   @relation("ProposalSubmitter")
  evaluations        Evaluation[] @relation("Evaluator")
  managedPilots      Pilot[]      @relation("PilotManager")
  uploadedDocuments  Document[]   @relation("DocumentUploader")
  auditLogs          AuditLog[]   @relation("AuditActor")

  @@map("users")
}

model Problem {
  id                  String                      @id @default(uuid()) @db.Uuid
  title               String                      @db.VarChar(255)
  slug                String                      @unique @db.VarChar(255)
  code                String                      @unique @db.VarChar(50)
  description         String                      @db.Text
  category            String                      @db.VarChar(100)
  severity            ProblemSeverity             @default(MEDIUM)
  status              ProblemStatus               @default(PUBLISHED)
  departmentId        String                      @map("department_id") @db.Uuid
  createdById         String                      @map("created_by_id") @db.Uuid
  budget              Decimal?                    @db.Decimal(12, 2)
  deadline            DateTime?
  eligibilityCriteria String?                     @map("eligibility_criteria") @db.Text
  expectedOutcomes    String?                     @map("expected_outcomes") @db.Text
  tags                String[]                    @default([])
  embedding           Unsupported("vector(384)")?
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("ProblemCreator", fields: [createdById], references: [id], onDelete: Restrict)
  proposals  Proposal[]
  pilots     Pilot[]
  documents  Document[]

  @@map("problems")
}

model Proposal {
  id                String                      @id @default(uuid()) @db.Uuid
  code              String                      @unique @db.VarChar(50)
  title             String                      @db.VarChar(255)
  summary           String                      @db.Text
  technicalApproach String                      @map("technical_approach") @db.Text
  budget            Decimal                     @db.Decimal(12, 2)
  durationMonths    Int                         @map("duration_months")
  status            ProposalStatus              @default(SUBMITTED)
  problemId         String                      @map("problem_id") @db.Uuid
  startupId         String                      @map("startup_id") @db.Uuid
  submittedById     String                      @map("submitted_by_id") @db.Uuid
  embedding         Unsupported("vector(384)")?
  submittedAt       DateTime                    @default(now()) @map("submitted_at")
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")

  problem     Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  startup     Startup      @relation(fields: [startupId], references: [id], onDelete: Cascade)
  submittedBy User         @relation("ProposalSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  evaluations Evaluation[]
  pilot       Pilot?
  documents   Document[]

  @@map("proposals")
}

model Evaluation {
  id               String                   @id @default(uuid()) @db.Uuid
  proposalId       String                   @map("proposal_id") @db.Uuid
  evaluatorId      String                   @map("evaluator_id") @db.Uuid
  technicalScore   Float                    @map("technical_score")
  feasibilityScore Float                    @map("feasibility_score")
  costScore        Float                    @map("cost_score")
  impactScore      Float                    @map("impact_score")
  overallScore     Float                    @map("overall_score")
  recommendation   EvaluationRecommendation
  comments         String                   @db.Text
  criteriaFeedback Json?                    @map("criteria_feedback")
  status           EvaluationStatus         @default(SUBMITTED)
  submittedAt      DateTime?                @map("submitted_at")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  proposal  Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  evaluator User     @relation("Evaluator", fields: [evaluatorId], references: [id], onDelete: Restrict)

  @@unique([proposalId, evaluatorId])
  @@map("evaluations")
}

model Pilot {
  id              String      @id @default(uuid()) @db.Uuid
  code            String      @unique @db.VarChar(50)
  title           String      @db.VarChar(255)
  scope           String      @db.Text
  status          PilotStatus @default(INITIATED)
  startDate       DateTime    @map("start_date")
  endDate         DateTime    @map("end_date")
  actualEndDate   DateTime?   @map("actual_end_date")
  allocatedBudget Decimal     @map("allocated_budget") @db.Decimal(12, 2)
  spentBudget     Decimal     @default(0.00) @map("spent_budget") @db.Decimal(12, 2)
  kpiTargets      Json?       @map("kpi_targets")
  kpiResults      Json?       @map("kpi_results")
  departmentId    String      @map("department_id") @db.Uuid
  startupId       String      @map("startup_id") @db.Uuid
  problemId       String      @map("problem_id") @db.Uuid
  proposalId      String      @unique @map("proposal_id") @db.Uuid
  managerId       String?     @map("manager_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  startup      Startup       @relation(fields: [startupId], references: [id], onDelete: Cascade)
  problem      Problem       @relation(fields: [problemId], references: [id], onDelete: Restrict)
  proposal     Proposal      @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  manager      User?         @relation("PilotManager", fields: [managerId], references: [id], onDelete: SetNull)
  milestones   Milestone[]
  procurements Procurement[]
  documents    Document[]

  @@map("pilots")
}

model Milestone {
  id                   String             @id @default(uuid()) @db.Uuid
  pilotId              String             @map("pilot_id") @db.Uuid
  title                String             @db.VarChar(255)
  description          String             @db.Text
  orderIndex           Int                @map("order_index")
  dueDate              DateTime           @map("due_date")
  completedDate        DateTime?          @map("completed_date")
  status               MilestoneStatus    @default(PENDING)
  deliverables         String?            @db.Text
  verificationCriteria String?            @map("verification_criteria") @db.Text
  verificationFeedback String?            @map("verification_feedback") @db.Text
  disbursementAmount   Decimal?           @map("disbursement_amount") @db.Decimal(12, 2)
  disbursementStatus   DisbursementStatus @default(NOT_APPLICABLE) @map("disbursement_status")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  pilot     Pilot      @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  documents Document[]

  @@map("milestones")
}

model Procurement {
  id                 String            @id @default(uuid()) @db.Uuid
  contractNumber     String            @unique @map("contract_number") @db.VarChar(100)
  title              String            @db.VarChar(255)
  description        String            @db.Text
  type               ProcurementType
  status             ProcurementStatus @default(DRAFT)
  pilotId            String?           @map("pilot_id") @db.Uuid
  departmentId       String            @map("department_id") @db.Uuid
  startupId          String            @map("startup_id") @db.Uuid
  contractValue      Decimal           @map("contract_value") @db.Decimal(14, 2)
  startDate          DateTime          @map("start_date")
  endDate            DateTime          @map("end_date")
  termsAndConditions String?           @map("terms_and_conditions") @db.Text
  approvalOfficer    String?           @map("approval_officer") @db.VarChar(255)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  pilot      Pilot?     @relation(fields: [pilotId], references: [id], onDelete: SetNull)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  startup    Startup    @relation(fields: [startupId], references: [id], onDelete: Cascade)
  documents  Document[]

  @@map("procurements")
}

model Document {
  id            String           @id @default(uuid()) @db.Uuid
  title         String           @db.VarChar(255)
  fileName      String           @map("file_name") @db.VarChar(255)
  fileSize      Int              @map("file_size")
  mimeType      String           @map("mime_type") @db.VarChar(100)
  fileUrl       String           @map("file_url") @db.VarChar(500)
  category      DocumentCategory
  uploadedById  String           @map("uploaded_by_id") @db.Uuid
  problemId     String?          @map("problem_id") @db.Uuid
  proposalId    String?          @map("proposal_id") @db.Uuid
  pilotId       String?          @map("pilot_id") @db.Uuid
  milestoneId   String?          @map("milestone_id") @db.Uuid
  procurementId String?          @map("procurement_id") @db.Uuid
  startupId     String?          @map("startup_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  uploadedBy  User         @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  problem     Problem?     @relation(fields: [problemId], references: [id], onDelete: Cascade)
  proposal    Proposal?    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  pilot       Pilot?       @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  milestone   Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  procurement Procurement? @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  startup     Startup?     @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String   @map("entity_id") @db.VarChar(100)
  payload   Json
  prevHash  String   @map("prev_hash") @db.VarChar(64)
  hash      String   @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("audit_logs")
}
